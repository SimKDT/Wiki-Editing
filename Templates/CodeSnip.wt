</noinclude><includeonly>{{#if:{{{source|}}}|'''{{tt|name=CodeSnip|default=Source:|arg1=source}}''' <code>{{#if:{{{path|}}}|{{{path}}}|{{#switch:{{{source}}}
| clothing_bags.txt | clothing_body.txt | clothing_hats.txt | clothing_jacket.txt | clothing_jewellery.txt | clothing_others.txt | clothing_pants.txt | clothing_shirts.txt | clothing_shoes.txt | clothing_suits.txt | clothing_underwear.txt = ProjectZomboid\media\scripts\clothing
| vehiclesitems.txt | vehiclesfixing.txt = ProjectZomboid\media\scripts\vehicles
| #default = ProjectZomboid\media\scripts
  }}
}}\<span style="color: #3434ff;">{{{source}}}</span></code>
}}
{{yesno|{{{retrieved|}}}|yes={{Retrieved|version={{{version|}}}|hidecat={{{hidecat|}}}|date={{{date|}}}|version_link={{{version_link|}}}}}
}}{{#if: {{{code|{{{1|}}}}}}
  | {{yesno|{{{line|}}}
    | yes = {{#tag:syntaxhighlight <!-- line attribute -->
      |{{{code|{{{1}}}}}} <!-- content -->
      |lang="{{#ifeq:{{{lang|{{{2|text}}}}}}|zedscripts|text|{{{lang|{{{2|text}}}}}}}}" <!-- attribute1 -->
      |line= <!-- attribute2 -->
      |start="{{{start|}}}" <!-- attribute3 -->
      |class="{{#ifeq:{{{lang|{{{2|text}}}}}}|zedscripts|zedscripts|}}"
    }}
    | no = {{#tag:syntaxhighlight <!-- no line attribute -->
      |{{{code|{{{1}}}}}} <!-- content -->
      |lang="{{#ifeq:{{{lang|{{{2|text}}}}}}|zedscripts|text|{{{lang|{{{2|text}}}}}}}}" <!-- attribute1 -->
      |class="{{#ifeq:{{{lang|{{{2|text}}}}}}|zedscripts|zedscripts|}}"
    }}
  }}
}}</includeonly>
