{
    "Lua.workspace.library": [
        "${addons}/scribunto/module/library"
    ],
    "Lua.runtime.builtin": {
        "package": "disable",
        "os": "disable",
        "debug": "disable",
        "io": "disable",
        "coroutine": "disable"
    },
    "Lua.workspace.checkThirdParty": false,
    "files.associations": {
        "console*.txt": "log",
        "coop-console*.txt": "log",
    },
    "logFileHighlighter.customPatterns": [
        {
            "pattern": "f:.*> ",
            "foreground": "#8b8b8b"
        },
        {
            "pattern": "^TRACE.*$",
            "foreground": "#CCCCCC"
        },
        {
            "pattern": "^NOISE.*$",
            "foreground": "#AA88FF"
        },
        {
            "pattern": "^DEBUG.*$",
            "foreground": "#56af56"
        },
        {
            "pattern": "^LOG.*$",
            "foreground": "#b6c1ca"
        },
        {
            "pattern": "^WARN.*$",
            "scope": "editorWarning"
        },
        {
            "pattern": "^ERROR.*$",
            "foreground": "#FF4444"
        },
        {
            "pattern": "Exception thrown[\\s\\S]*?(?=^\\s*(TRACE|NOISE|DEBUG|LOG|WARN))",
            "foreground": "#FF4444",
            "patternFlags": "s"
        },
        {
            "pattern": "^-----------------------------------------.*?(TRACE|NOISE|DEBUG|LOG|WARN|ERROR)",
            "foreground": "#FF4444",
            "patternFlags": "si",
        },
    ]
}